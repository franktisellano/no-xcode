# Copy to .asc.env (gitignored). App Store Connect API key, used by `make testflight`
# and (optionally) to provision device builds without an Xcode account sign-in.
# App Store Connect → Users and Access → Integrations → App Store Connect API → Team Keys.
# No quotes, no spaces around "=": this file is read by both bash and make.
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ASC_KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8
